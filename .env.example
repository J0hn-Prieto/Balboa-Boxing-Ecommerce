# Copia este archivo como ".env" y completa los valores.
# El archivo .env nunca se sube a GitHub.

# --- General ---
DEBUG=true
# Clave larga y aleatoria. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
BASE_URL=http://localhost:8000

# --- Catálogo ---
# Excel que importa "python -m scripts.import_catalog". Ruta absoluta o relativa al proyecto.
CATALOG_XLSX=data/catalogo_balboa_boxing.xlsx

# --- PostgreSQL ---
# Usa los mismos datos con los que te conectas en pgAdmin.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=balboa_ecommerce
DB_USER=postgres
DB_PASSWORD=

# --- Envíos (pesos colombianos) ---
FREE_SHIPPING_THRESHOLD=120000
SHIPPING_COST=10000

# --- Contacto y redes ---
# WhatsApp: indicativo + número, sin "+" ni espacios.
WHATSAPP_NUMBER=573118323432
WHATSAPP_MESSAGE=Hola, quiero información sobre un producto
PHONE_NUMBER=+573118323432
INSTAGRAM_URL=https://www.instagram.com/explore/locations/1940252736244634/balboa-boxing-club-bogota/
FACEBOOK_URL=
